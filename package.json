{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server.js",
    "start": "node server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "test:postgres": "bun test tests/postgres-integration-guard.test.ts tests/postgres-payments.integration.test.ts",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:baseline:generate": "drizzle-kit generate --config=src/db/drizzle-fresh.config.ts --name=application-baseline",
    "db:init:fresh": "tsx scripts/initialize-fresh-database.ts",
    "db:migrate": "drizzle-kit migrate --config=src/db/drizzle.config.ts",
    "db:check": "drizzle-kit check --config=src/db/drizzle.config.ts",
    "db:seed:reference": "tsx scripts/seed-reference-data.ts",
    "db:seed:products": "tsx scripts/seed-unique-products.ts",
    "db:seed:parts": "tsx scripts/seed-parts.ts",
    "db:reservations:expire": "tsx scripts/expire-inventory-reservations.ts",
    "db:images:update": "tsx scripts/update-product-images.ts",
    "db:images:distribute": "tsx scripts/distribute-unique-car-images.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
