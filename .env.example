# Copy this file to .env for local development. Never commit .env or real secrets.
# The database settings below support either DATABASE_URL (preferred) or the
# individual SQL_* values. DATABASE_URL takes precedence when both are set.

# Option A: PostgreSQL connection URL (recommended for Supabase).
# Paste the connection string from Supabase Dashboard > Connect. URL-encode
# special characters in the password. Keep this server-side; never use VITE_ prefix.
# DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres

# Option B: local PostgreSQL credentials (used only when DATABASE_URL is blank).
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DB_NAME=rc_mega
SQL_USER=rc_mega_app
SQL_PASSWORD=replace-with-a-local-password

# auto = SSL for remote hosts, no SSL for localhost/127.0.0.1/::1.
# Use true for Supabase/remote PostgreSQL. true verifies the server certificate.
# Use false only for local development or a deliberately unencrypted trusted network.
DATABASE_SSL=auto

# Fresh database initialization is separate from normal runtime/migration credentials.
# Set FRESH_DATABASE_URL explicitly, verify the fingerprint, and use the exact command flag.
# Never reuse a production database or target that matches DATABASE_URL/MIGRATION_DATABASE_URL/SQL_*.
# FRESH_DATABASE_URL=postgresql://fresh_user:<PASSWORD>@127.0.0.1:55432/rcmega_fresh
# FRESH_DATABASE_EXPECTED_FINGERPRINT=localhost:55432/rcmega_fresh
# FRESH_DATABASE_ENABLED=false
# FRESH_DATABASE_CONFIRMATION=I_CONFIRM_EMPTY_NONPRODUCTION_DATABASE
# FRESH_DATABASE_SSL=auto
# Remote targets require additional explicit opt-in and independent fingerprint verification:
# ALLOW_REMOTE_FRESH_DATABASE=true

# Optional: separate DDL-capable connection for Drizzle migrations. If blank,
# migrations use DATABASE_URL (or the individual SQL_* values). Never grant this
# credential to the application runtime if a restricted runtime DB role is available.
# MIGRATION_DATABASE_URL="postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres"

# Legacy migration-only split credentials, used only with individual SQL_* settings.
# Prefer MIGRATION_DATABASE_URL when separating migration and runtime roles.
# SQL_ADMIN_USER=replace-with-migration-user
# SQL_ADMIN_PASSWORD=replace-with-migration-password

# Optional platform variables retained for Google AI Studio deployments.
# These are not used by the current storefront source code.
# GEMINI_API_KEY=replace-with-your-key
# APP_URL=https://your-host.example

# Express port (optional; defaults to 3000).
# PORT=3000
# NODE_ENV=development
# DISABLE_HMR=false

# Reservation cleanup CLI requires this AND the --confirm-cleanup CLI flag.
# Keep false locally; enable only in the explicitly configured scheduler environment.
RESERVATION_CLEANUP_ENABLED=false

# Optional protected endpoint for a compatible external scheduler. Generate a
# unique random secret of at least 32 characters; server-side only.
# CRON_SECRET=replace-with-a-unique-random-secret

# Optional flat shipping charge in INR. Unset or 0.00 means free shipping.
# SHIPPING_FLAT_RATE_INR=0.00

# PostgreSQL integration tests are opt-in and use a separate disposable database only.
# The database name must include a distinct "test" segment; never use app/staging/production credentials.
# RUN_POSTGRES_INTEGRATION_TESTS=true
# TEST_DATABASE_URL=postgresql://test-user:<PASSWORD>@localhost:5432/rcmega_test
# The URL must contain explicit non-empty credentials; PGUSER/PGPASSWORD are never used as fallback.
# POSTGRES_TEST_DATABASE_CONFIRMATION=I_CONFIRM_DISPOSABLE_TEST_DATABASE
# TEST_DATABASE_SSL=auto
# Remote targets are rejected unless both settings are explicitly verified:
# ALLOW_REMOTE_TEST_DATABASE=true
# TEST_DATABASE_EXPECTED_FINGERPRINT=db.example.test:5432/rcmega_test

# Supabase Auth: use the project URL and publishable/anon key only in the browser.
# These values are public; never place a service-role or secret key in VITE_* variables.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-side verification uses the same public anon key. Do not use a service-role key.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Comma-separated owner email allowlist. Server only; allowlisted addresses must be verified.
# ADMIN_EMAILS=owner@example.com

# Product image uploads: server-only Storage admin credential and public bucket.
# Create the bucket in Supabase Storage and configure it as public for storefront images.
# Never prefix the service-role/secret key with VITE_ or expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-or-secret-key
# SUPABASE_STORAGE_BUCKET=product-images

# Razorpay Test Mode only. The server rejects Key IDs without the rzp_test_ prefix.
# Only the public Key ID is returned to Razorpay Checkout; keep both secrets server-side.
RAZORPAY_KEY_ID=rzp_test_replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace-with-test-mode-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-test-mode-webhook-secret
